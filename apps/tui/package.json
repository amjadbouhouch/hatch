{
  "name": "@hatch/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "hatch": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
