{
  "name": "hatch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:desktop": "turbo dev --filter=@hatch/desktop",
    "dev:gateway": "turbo dev --filter=@hatch/gateway",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "bun run --cwd packages/database db:migrate",
    "db:studio": "bun run --cwd packages/database db:studio",
    "db:seed": "bun run --cwd packages/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3"
  }
}
